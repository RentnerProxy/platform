                        "durationMs": 1,
                        "addresses": [],
                        "httpStatus": null
                    },
                    "dns": {
                        "status": "unknown",
                        "code": "skipped",
                        "durationMs": 0,
                        "addresses": [],
                        "httpStatus": null
                    },
                    "upstream": {
                        "status": "passed",
                        "code": "upstream_responded",
                        "durationMs": 42,
                        "addresses": [],
                        "httpStatus": 204
                    },
                    "tls": {
                        "status": "not_applicable",
                        "code": "http_upstream",
                        "durationMs": 0,
                        "addresses": [],
                        "httpStatus": null
                    }
                }
            },
            "result": {
                "outcome": "probed",

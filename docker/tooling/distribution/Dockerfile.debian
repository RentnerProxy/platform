FROM mirror.gcr.io/library/debian:13@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash ca-certificates coreutils curl dbus gnupg gpgv iproute2 nftables podman procps python3 skopeo systemd systemd-sysv util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && touch /rentnerproxy-isolated-distribution \
    && truncate -s 0 /etc/machine-id
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
